<UserControl x:Class="Backuper_UI.Views.ClusterListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Backuper_UI.Views"
             xmlns:s="clr-namespace:Backuper_UI.Services"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="580">

    <ListView ItemsSource="{Binding Clusters}" SelectedItem="{Binding SelectedCluster}" FontSize="14" Foreground="Black">

        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick"/> <!-- code behind -->
                <Setter Property="Height" Value="30"/>
            </Style>
        </ListView.ItemContainerStyle>

        <ListView.View>
            <GridView>
                <GridView.ColumnHeaderContainerStyle>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="10,0,0,0"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </GridView.ColumnHeaderContainerStyle>

                <GridViewColumn Header="{s:Loc HeaderClusterName}" DisplayMemberBinding="{Binding Name}" Width="150"/>
                <GridViewColumn Header="{s:Loc HeaderClusterDescription}" DisplayMemberBinding="{Binding Description}" Width="400"/>
            </GridView>
        </ListView.View>
        
    </ListView>
</UserControl>
