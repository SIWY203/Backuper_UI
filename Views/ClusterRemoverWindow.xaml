<Window x:Class="Backuper_UI.Views.ClusterRemoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Backuper_UI"
        xmlns:vm="clr-namespace:Backuper_UI.ViewModels"
        mc:Ignorable="d"
        Title="Backuper" Height="400" Width="500">

    <!-- ViewModel -->
    <Window.DataContext>
        <vm:ClusterRemoverWindowViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Cluster Remover" FontSize="14" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
        </DockPanel>

        <Label Content="Cluster list" HorizontalAlignment="Left" Margin="10,15,0,0" Grid.Row="1" VerticalAlignment="Top"/>

        <Button x:Name="btnBack" Content="Back" HorizontalAlignment="Left" Margin="10,10,0,10" Grid.Row="2" VerticalAlignment="Top" Height="30" Width="100" IsCancel="True"/>

        <Button Content="Remove" HorizontalAlignment="Left" Margin="370,0,0,0" Grid.Row="2" VerticalAlignment="Center" Height="30" Width="100"/>
        <ListBox Grid.Row="1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,46,0,0"/>


    </Grid>
</Window>
