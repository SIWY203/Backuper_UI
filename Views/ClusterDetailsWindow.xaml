<Window x:Class="Backuper_UI.Views.ClusterDetailsWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:Backuper_UI.Views"
            xmlns:s="clr-namespace:Backuper_UI.Services"
            mc:Ignorable="d" 
            Title="Backuper" Height="350" Width="560">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="{s:Loc Name}" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cluster.Name}" Margin="0,0,0,10"/>

            <TextBlock Text="{s:Loc SourcePath}" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cluster.Source}" Margin="0,0,0,10"/>

            <TextBlock Text="{s:Loc TargetPath}" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cluster.Target}" Margin="0,0,0,10"/>

            <TextBlock Text="{s:Loc Description}" FontWeight="Bold"/>
            <TextBlock Text="{Binding Cluster.Description}" Margin="0,0,0,10" TextWrapping="WrapWithOverflow" Height="122"/>

        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center" Grid.Row="2">

            <Button Content="{s:Loc BtnBack}" HorizontalAlignment="Left" 
                    Margin="0, 0, 5, 0" VerticalAlignment="Top" Height="30" Width="100" IsCancel="True"/>

            <Button Content="{s:Loc BtnCreateBackup}" Command="{Binding CreateBackupCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" 
                    Margin="0, 0, 5, 0" Height="30" Width="100" />

            <Button Content="{s:Loc BtnRestoreBackup}" Command="{Binding RestoreBackupCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" 
                    Margin="0, 0, 5, 0" Height="30" Width="100"  />

            <Button Content="{s:Loc BtnUndoRestore}" Command="{Binding UndoRestoreCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" 
                    Margin="0, 0, 5, 0" Height="30" Width="100"  />

            <Button Content="{s:Loc BtnShowBackups}" Command="{Binding ShowBackupsCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" 
                    Margin="0, 0, 0, 0" Height="30" Width="100" />

        </StackPanel>

    </Grid>

</Window>
    
    
