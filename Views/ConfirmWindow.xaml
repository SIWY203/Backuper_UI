<Window x:Class="Backuper_UI.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Backuper_UI"
        xmlns:vm="clr-namespace:Backuper_UI.ViewModels"
        mc:Ignorable="d"
        Title="Backuper" Height="200" Width="300">

    <!-- ViewModel -->
    <Window.DataContext>
        <vm:ConfirmViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Restore backup" FontSize="14" FontWeight="Bold" Width="279"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
        </DockPanel>

        <Label Content="Are you sure you want to restore backup?" HorizontalAlignment="Center" Margin="0,15,0,0" Grid.Row="1" VerticalAlignment="Top" Width="260"/>
        <Label Content="Current data will be saved and ready to undo." HorizontalAlignment="Center" Margin="0,30,0,0" Grid.Row="1" VerticalAlignment="Top" Width="260"/>

        <Button Content="No, cancel" 
                IsCancel="True"
                HorizontalAlignment="Left" Margin="10,10,0,10" Grid.Row="2" VerticalAlignment="Top" Height="30" Width="100"/>

        <Button Content="Yes, do it" 
                Command="{Binding ConfirmCommand}"
                HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Row="2" VerticalAlignment="Center" Height="30" Width="100"/>

    </Grid>
</Window>
