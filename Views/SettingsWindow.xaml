<Window x:Class="Backuper_UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Backuper_UI"
        xmlns:vm="clr-namespace:Backuper_UI.ViewModels"
        mc:Ignorable="d"
        Title="Backuper" Height="450" Width="600">

    <!-- ViewModel -->
    <Window.DataContext>
        <vm:SettingsWindowViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Settings" FontSize="14" FontWeight="Bold" Width="100"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
        </DockPanel>
        
        <Label Content="Language" HorizontalAlignment="Left" Margin="10,15,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Label Content="Backup Limit" HorizontalAlignment="Left" Margin="10,41,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Label Content="Snapshot Limit" HorizontalAlignment="Left" Margin="10,68,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <ComboBox x:Name="comboLanguage" HorizontalAlignment="Left" Margin="120,15,0,0" Grid.Row="1" VerticalAlignment="Top" Width="120" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"/>
        <TextBox x:Name="tbBackupLimit" HorizontalAlignment="Left" Margin="120,45,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding BackupLimit}" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbSnapshotLimit" HorizontalAlignment="Left" Margin="120,72,0,0" Grid.Row="1" TextWrapping="Wrap" Text="{Binding SnapshotLimit}" VerticalAlignment="Top" Width="120"/>

        <Button x:Name="btnBack" Content="Back" HorizontalAlignment="Left" Margin="10,10,0,10" Grid.Row="2" VerticalAlignment="Top" Height="30" Width="100" IsCancel="True"/>


    </Grid>
</Window>
