<Window x:Class="Backuper_UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Backuper_UI"
        xmlns:vm="clr-namespace:Backuper_UI.ViewModels"
        xmlns:views="clr-namespace:Backuper_UI.Views"
        xmlns:s="clr-namespace:Backuper_UI.Services"
        mc:Ignorable="d"
        Title="Backuper" Height="450" Width="600">

    <!-- ViewModel -->
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- row1 -->
            <RowDefinition Height="*"/>
            <!-- row2 -->
        </Grid.RowDefinitions>

        <!-- Navbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">

            <Label Content="{s:Loc ClusterList}" FontSize="14" FontWeight="Bold" Width="100"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{s:Loc BtnAddCluster}" 
                        Command="{Binding AddClusterCommand}" 
                        Width="100" Height="30" Margin="0,0,5,0" HorizontalAlignment="Center"/>

                <Button Content="{s:Loc BtnRemoveCluster}" 
                        Command="{Binding RemoveClusterCommand}" 
                        Width="100" Height="30" Margin="0,0,5,0"/>

                <!-- <Button Content="Details" 
                        Command="{Binding OpenDetailsCommand}" 
                        Width="100" Height="30" Margin="0,0,5,0"/> -->

                <Button Content="{s:Loc BtnSettings}" 
                        Command="{Binding OpenSettingsCommand}" 
                        Width="100" Height="30" />

            </StackPanel>
        </DockPanel>

        <!-- Cluster list -->
        <views:ClusterListView DataContext="{Binding ClusterList}" Grid.Row="1"/>


    </Grid>
</Window>
