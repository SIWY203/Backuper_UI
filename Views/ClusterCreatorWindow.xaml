<Window x:Class="Backuper_UI.Views.ClusterCreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Backuper_UI"
        xmlns:vm="clr-namespace:Backuper_UI.ViewModels"
        xmlns:s="clr-namespace:Backuper_UI.Services"
        mc:Ignorable="d"
        Title="Backuper" Height="360" Width="480">

    <!-- ViewModel -->
    <Window.DataContext>
        <vm:ClusterCreatorViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Cluster Creator" FontSize="14" FontWeight="Bold" Width="150"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
        </DockPanel>

        <Label Content="{s:Loc ClusterName}" HorizontalAlignment="Left" Margin="10,15,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Label Content="{s:Loc SourcePath}" HorizontalAlignment="Left" Margin="10,41,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Label Content="{s:Loc TargetPath}" HorizontalAlignment="Left" Margin="10,68,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Label Content="{s:Loc Description}" HorizontalAlignment="Left" Margin="10,94,0,0" Grid.Row="1" VerticalAlignment="Top"/>

        <TextBox HorizontalAlignment="Left" Margin="120,19,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Text="{Binding ClusterName, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox HorizontalAlignment="Left" Margin="120,45,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox HorizontalAlignment="Left" Margin="120,72,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="300" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox HorizontalAlignment="Left" Margin="120,98,0,10" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Stretch" Width="300" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

        <Button Content="{s:Loc BtnCreate}" Command="{Binding AddClusterCommand}" HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Row="2" VerticalAlignment="Center" Height="30" Width="100"/>

        <Button Content="{s:Loc BtnBack}" HorizontalAlignment="Left" Margin="10,10,0,10" Grid.Row="2" VerticalAlignment="Top" Height="30" Width="100" IsCancel="True"/>


    </Grid>
</Window>
